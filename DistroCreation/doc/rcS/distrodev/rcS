#!/bin/sh

# ============================================================
# LVGD486 - System Initialization
# ============================================================

# Mount proc
mount -t proc proc /proc

# Configure Ethernet using DHCP
echo "Configuring network interface eth0..."
ifconfig eth0 up
udhcpc -i eth0 -s /usr/share/udhcpc/default.script
echo "DHCP client exited with status $?"

# Ensure the virtual console device exists.
if [ ! -c /dev/tty0 ]; then
    echo "Creating /dev/tty0"
    mknod -m 600 /dev/tty0 c 4 0
fi

# Configure the Spanish keyboard layout.
if [ -x /bin/loadkeys ]; then
    if [ -f /usr/share/keymaps/es.map ]; then
        /bin/loadkeys /usr/share/keymaps/es.map
    elif [ -f /usr/share/keymaps/i386/qwerty/es.map ]; then
        /bin/loadkeys /usr/share/keymaps/i386/qwerty/es.map
    else
        echo "WARNING: Spanish keyboard map not found; keeping default layout."
    fi
fi

exit 0